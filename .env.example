# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# --- Required ---
# Single API key:
GEMINI_API_KEY=your_gemini_api_key_here
# OR multiple API keys (comma-separated or WS_GEMINI_API_KEYS=["key1","key2"]) for automatic rotation & quota balancing:
# WS_GEMINI_API_KEYS=["key1","key2","key3"]

# --- Optional overrides (all have defaults in config/defaults.toml) ---
WS_ENVIRONMENT=development
WS_DEBUG=false
WS_LOG_LEVEL=INFO

WS_API_PORT=8000
WS_CORS_ORIGINS=["http://localhost:3000"]

WS_REDIS_URL=redis://localhost:6379/0

# Auth secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
WS_AUTH_SECRET=change_me_generate_a_real_secret
